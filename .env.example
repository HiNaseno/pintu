# Backend-only configuration. Copy to .env and keep it out of Git.
# Pi manages analysis, questions and planning through the server's signed-in CLI.
AI_PROVIDER=pi
CODEX_BIN=codex
CODEX_MODEL=gpt-6.1-sol
CODEX_REASONING_EFFORT=medium
CODEX_TIMEOUT_MS=600000

# Use openai for a Responses + Images-compatible provider. Fill models supported by that provider.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEXT_MODEL=
OPENAI_IMAGE_MODEL=
OPENAI_PREVIEW_IMAGE_MODEL=

HOST=127.0.0.1
PORT=5176
# real uses the configured provider; disabled permits browsing but refuses image execution.
# Mock mode is reserved for isolated tests and is not a real image provider.
PINTU_ENGINE_MODE=real
# LAN access requires a hash generated by: npm run access-code
# Never put the original access code here or in a URL.
PINTU_ACCESS_CODE_HASH=
# Exact browser origins. For LAN/proxy use, add the origin users actually open.
PINTU_ALLOWED_ORIGINS=http://127.0.0.1:5176,http://localhost:5176
# Set true only when accessing the app through HTTPS.
PINTU_COOKIE_SECURE=false
# Optional Base64 of 32 random bytes; empty creates a private key under runtime/execution/.
PINTU_ENCRYPTION_KEY=

GENERATED_FILE_TTL_HOURS=24
AI_REQUEST_TIMEOUT_MS=360000
CONFIG_REQUEST_TIMEOUT_MS=30000
IMAGE_REQUEST_TIMEOUT_MS=120000
MAX_RECOMMENDED_SYNC_OUTPUTS=12
# Image dispatch is single-attempt; uncertain results are retained for reconciliation.
IMAGE_GENERATION_MAX_ATTEMPTS=1
IMAGE_GENERATION_RETRY_DELAY_MS=4000
MODEL_PREVIEW_INPUT_SIZE=512
MODEL_STANDARD_INPUT_SIZE=640
MODEL_HIGH_INPUT_SIZE=768
